<Page x:Class="MoneyTracker2026.Views.BudgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MoneyTracker2026.Views"
      Title="Budgets">

    <Grid Background="#1E1E1E">
        <StackPanel Margin="20">
            <TextBlock Text="Budgets" FontSize="28" FontWeight="Bold" Foreground="#00C4B4" Margin="0,0,0,20"/>
            
            <TextBlock x:Name="MonthYearText" Text="January 2026" FontSize="18" Foreground="White" Margin="0,0,0,20"/>
            
            <Button Content="Add Budget" Background="#00C4B4" Foreground="White" 
                    Padding="20,10" HorizontalAlignment="Left" Click="AddBudget_Click"/>
            
            <ListView x:Name="BudgetsGrid" Background="Transparent" BorderThickness="0" Margin="0,20,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" Padding="15" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CategoryName}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,5,0,0" Background="#444444" Foreground="#00C4B4"/>
                                    <TextBlock Text="{Binding ProgressText}" Foreground="#888888" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
