<Page x:Class="MoneyTracker2026.Views.DebtsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MoneyTracker2026.Views"
      Title="Debts">

    <Grid Background="#1E1E1E">
        <StackPanel Margin="20">
            <TextBlock Text="Debts" FontSize="28" FontWeight="Bold" Foreground="#00C4B4" Margin="0,0,0,20"/>
            
            <!-- Summary Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="#2D2D30" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Total Debt" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="TotalDebtText" Text="£0.00" Foreground="#FF6B6B" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Monthly Payment" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="MonthlyPaymentText" Text="£0.00" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Background="#2D2D30" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Debt Free Date" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="DebtFreeText" Text="TBD" Foreground="#5BD787" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <Button Content="Add Debt" Background="#00C4B4" Foreground="White" 
                    Padding="20,10" HorizontalAlignment="Left" Click="AddDebt_Click"/>
            
            <ListView x:Name="DebtsList" Background="Transparent" BorderThickness="0" Margin="0,20,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" Padding="15" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Details}" Foreground="#888888" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}" Foreground="#FF6B6B" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
