<Page x:Class="MoneyTracker2026.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MoneyTracker2026.Views"
      Title="Reports">

    <Grid Background="#1E1E1E">
        <StackPanel Margin="20">
            <TextBlock Text="Reports" FontSize="28" FontWeight="Bold" Foreground="#00C4B4" Margin="0,0,0,20"/>
            
            <!-- Date Range -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <DatePicker x:Name="StartDatePicker" Grid.Column="0" Background="#2D2D30" Foreground="White" Margin="0,0,10,0"/>
                <DatePicker x:Name="EndDatePicker" Grid.Column="1" Background="#2D2D30" Foreground="White" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="Generate Report" Background="#00C4B4" Foreground="White" Padding="20,10" Click="GenerateReport_Click"/>
                <Button Grid.Column="3" Content="Export" Background="#00C4B4" Foreground="White" Padding="20,10" Margin="10,0,0,0" Click="Export_Click"/>
            </Grid>
            
            <!-- Summary -->
            <Border Background="#2D2D30" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Income vs Expenses" Foreground="#AAAAAA" FontSize="14"/>
                    <TextBlock x:Name="IncomeExpensesSummary" Text="£0.00 income | £0.00 expenses" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Category Breakdown -->
            <TextBlock Text="Category Breakdown" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
            <ListView x:Name="CategoryBreakdownList" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" Padding="15" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CategoryName}" Foreground="White" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <!-- Import/Export -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Import CSV" Background="#00C4B4" Foreground="White" Padding="20,10" Margin="0,0,10,0" Click="Import_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
