<Page x:Class="MoneyTracker2026.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MoneyTracker2026.Views"
      Title="Settings">

    <Grid Background="#1E1E1E">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#00C4B4" Margin="0,0,0,20"/>
            
            <!-- General Settings -->
            <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
            <Border Background="#2D2D30" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Base Currency" Foreground="#AAAAAA" FontSize="14"/>
                        <ComboBox x:Name="CurrencyComboBox" Background="#444444" Foreground="White" Padding="10" Margin="0,5,0,0">
                            <ComboBoxItem Content="GBP (£)" IsSelected="True"/>
                            <ComboBoxItem Content="USD ($)"/>
                            <ComboBoxItem Content="EUR (€)"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Theme" Foreground="#AAAAAA" FontSize="14"/>
                        <ComboBox x:Name="ThemeComboBox" Background="#444444" Foreground="White" Padding="10" Margin="0,5,0,0">
                            <ComboBoxItem Content="Dark" IsSelected="True"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Profile Settings -->
            <TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
            <Border Background="#2D2D30" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Current Profile" Foreground="#AAAAAA" FontSize="14"/>
                        <ComboBox x:Name="ProfileComboBox" Background="#444444" Foreground="White" Padding="10" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Content="New Profile" Background="#00C4B4" Foreground="White" Padding="15,8" Margin="0,0,10,0" Click="NewProfile_Click"/>
                        <Button Content="Delete Profile" Background="#FF6B6B" Foreground="White" Padding="15,8" Click="DeleteProfile_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Backup Settings -->
            <TextBlock Text="Backup" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
            <Border Background="#2D2D30" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox x:Name="AutoBackupCheckBox" Content="Auto-backup on close" Foreground="White" IsChecked="True" Margin="0,0,0,15"/>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Backup Now" Background="#00C4B4" Foreground="White" Padding="15,8" Margin="0,0,10,0" Click="BackupNow_Click"/>
                        <Button Content="Restore Backup" Background="#00C4B4" Foreground="White" Padding="15,8" Click="RestoreBackup_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Currency Rates -->
            <TextBlock Text="Currency Rates" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
            <Border Background="#2D2D30" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Exchange rates relative to GBP" Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="USD ($)" Foreground="#AAAAAA" FontSize="12"/>
                            <TextBox x:Name="USDRateTextBox" Text="1.30" Background="#444444" Foreground="White" Padding="5"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="EUR (€)" Foreground="#AAAAAA" FontSize="12"/>
                            <TextBox x:Name="EURRateTextBox" Text="1.18" Background="#444444" Foreground="White" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Save Button -->
            <Button Content="Save Settings" Background="#00C4B4" Foreground="White" Padding="30,12" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
        </StackPanel>
    </Grid>
</Page>
