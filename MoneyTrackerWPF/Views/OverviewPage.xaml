<Page x:Class="MoneyTracker2026.Views.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MoneyTracker2026.Views"
      Title="Overview">

    <Grid Background="#1E1E1E">
        <StackPanel Margin="20">
            <TextBlock Text="Overview" FontSize="28" FontWeight="Bold" Foreground="#00C4B4" Margin="0,0,0,20"/>
            
            <!-- Balance Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="#2D2D30" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Total Balance" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="TotalBalanceText" Text="£0.00" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Monthly Income" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="MonthlyIncomeText" Text="£0.00" Foreground="#5BD787" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Background="#2D2D30" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Monthly Expenses" Foreground="#AAAAAA" FontSize="14"/>
                        <TextBlock x:Name="MonthlyExpensesText" Text="£0.00" Foreground="#FF6B6B" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Net Worth -->
            <Border Background="#2D2D30" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Net Worth" Foreground="#AAAAAA" FontSize="14"/>
                    <TextBlock x:Name="NetWorthText" Text="£0.00" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Recent Transactions -->
            <TextBlock Text="Recent Transactions" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,30,0,10"/>
            <ListView x:Name="RecentTransactionsList" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Description}" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" Foreground="#888888" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedAmount}" Foreground="{Binding AmountColor}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
