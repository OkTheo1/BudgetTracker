<Page x:Class="MoneyTracker2026.Views.TransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MoneyTracker2026.Views"
      Title="Transactions">

    <Grid Background="#1E1E1E">
        <StackPanel Margin="20">
            <TextBlock Text="Transactions" FontSize="28" FontWeight="Bold" Foreground="#00C4B4" Margin="0,0,0,20"/>
            
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="SearchBox" Grid.Column="0" Background="#2D2D30" Foreground="White" 
                         BorderBrush="#444444" Padding="10" FontSize="14" 
                         TextChanged="SearchBox_TextChanged"/>
                
                <Button Grid.Column="1" Content="Add Transaction" Background="#00C4B4" Foreground="White" 
                        Padding="20,10" Margin="10,0,0,0" Click="AddTransaction_Click"/>
            </Grid>
            
            <ListView x:Name="TransactionsList" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" Padding="15" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Description}" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" Foreground="#888888" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedAmount}" 
                                           Foreground="{Binding AmountColor}" FontSize="16" FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
