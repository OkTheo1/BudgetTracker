<Window x:Class="MoneyTracker2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Money Tracker 2026 - £ GBP"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Navigation Menu -->
        <Border Grid.Column="0" Background="#252526">
            <StackPanel>
                <!-- App Title -->
                <TextBlock Text="Money Tracker 2026"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#00C4B4"
                           Margin="20,20,20,30"/>
                
                <!-- Menu Items -->
                <Button x:Name="OverviewBtn" Content="Overview" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Overview_Click"/>
                
                <Button x:Name="TransactionsBtn" Content="Transactions" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Transactions_Click"/>
                
                <Button x:Name="BudgetsBtn" Content="Budgets" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Budgets_Click"/>
                
                <Button x:Name="GoalsBtn" Content="Goals" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Goals_Click"/>
                
                <Button x:Name="DebtsBtn" Content="Debts" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Debts_Click"/>
                
                <Button x:Name="ReportsBtn" Content="Reports" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Reports_Click"/>
                
                <Button x:Name="SettingsBtn" Content="Settings" 
                        Background="Transparent" Foreground="White" 
                        HorizontalContentAlignment="Left" Padding="20,12"
                        BorderThickness="0" Click="Settings_Click"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
