<Page
    x:Class="MoneyTracker2026.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoneyTracker2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="Settings" 
                       FontSize="28" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- Profile Section -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Profile" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Current Profile" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                    <ComboBox x:Name="ProfileComboBox" Width="300" HorizontalAlignment="Left" Margin="0,8,0,16" SelectionChanged="ProfileComboBox_SelectionChanged">
                        <ComboBoxItem Content="Main" IsSelected="True"/>
                    </ComboBox>
                    
                    <Button Content="Create New Profile" Click="CreateProfile_Click"/>
                </StackPanel>
            </Border>

            <!-- Currency Settings -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Currency" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Base Currency" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                    <ComboBox x:Name="BaseCurrencyComboBox" Width="300" HorizontalAlignment="Left" Margin="0,8,0,16" SelectionChanged="BaseCurrency_SelectionChanged">
                        <ComboBoxItem Content="£ GBP - British Pound" IsSelected="True"/>
                        <ComboBoxItem Content="$ USD - US Dollar"/>
                        <ComboBoxItem Content="€ EUR - Euro"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Backup Settings -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Backup" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Auto-backup on close: Enabled" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Backup location: Documents\MoneyTrackerBackups" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"/>
                    
                    <Button Content="Backup Now" Margin="0,16,0,0" Click="BackupNow_Click"/>
                </StackPanel>
            </Border>

            <!-- Theme Settings -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Theme" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Accent Color" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Width="40" Height="40" Background="#00C4B4" CornerRadius="20" Margin="0,0,8,0" BorderThickness="2" BorderBrush="White"/>
                        <Border Width="40" Height="40" Background="#5BD787" CornerRadius="20" Margin="0,0,8,0"/>
                        <Border Width="40" Height="40" Background="#4A90D9" CornerRadius="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="About" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="MoneyTracker 2026" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Version 1.0.0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
