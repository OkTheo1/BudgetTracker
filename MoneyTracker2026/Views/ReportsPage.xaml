<Page
    x:Class="MoneyTracker2026.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoneyTracker2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Reports" 
                       FontSize="28" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Import CSV" Click="Import_Click" Margin="0,0,8,0"/>
                <Button Content="Export" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Export_Click"/>
            </StackPanel>
        </Grid>

        <!-- Date Range Selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <DatePicker x:Name="StartDatePicker"/>
            <TextBlock Text="to" VerticalAlignment="Center" Margin="16,0"/>
            <DatePicker x:Name="EndDatePicker"/>
            <Button Content="Apply" Margin="16,0,0,0" Click="ApplyDateRange_Click"/>
        </StackPanel>

        <!-- Charts Section -->
        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <!-- Income vs Expenses -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Income vs Expenses" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock x:Name="IncomeExpensesSummary" Text="Income: £0.00 | Expenses: £0.00" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Category Breakdown -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Spending by Category" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <ListView x:Name="CategoryBreakdownList" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="20"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Monthly Trend -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Monthly Trend" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock x:Name="MonthlyTrendText" Text="Loading..." Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
