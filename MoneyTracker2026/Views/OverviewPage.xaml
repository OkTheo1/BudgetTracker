<Page
    x:Class="MoneyTracker2026.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoneyTracker2026.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="Overview" 
                       FontSize="28" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- Summary Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Balance Card -->
                <Border Grid.Column="0" 
                        Background="{StaticResource CardBrush}" 
                        CornerRadius="12" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Total Balance" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="14"/>
                        <TextBlock x:Name="TotalBalanceText" 
                                   Text="£0.00" 
                                   Foreground="{StaticResource PrimaryBrush}" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Monthly Income Card -->
                <Border Grid.Column="2" 
                        Background="{StaticResource CardBrush}" 
                        CornerRadius="12" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Monthly Income" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="14"/>
                        <TextBlock x:Name="MonthlyIncomeText" 
                                   Text="£0.00" 
                                   Foreground="{StaticResource SuccessBrush}" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Monthly Expenses Card -->
                <Border Grid.Column="4" 
                        Background="{StaticResource CardBrush}" 
                        CornerRadius="12" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Monthly Expenses" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="14"/>
                        <TextBlock x:Name="MonthlyExpensesText" 
                                   Text="£0.00" 
                                   Foreground="{StaticResource ErrorBrush}" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Net Worth Section -->
            <Border Background="{StaticResource CardBrush}" 
                    CornerRadius="12" 
                    Padding="20"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Net Worth" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="14"/>
                    <TextBlock x:Name="NetWorthText" 
                               Text="£0.00" 
                               Foreground="{StaticResource PrimaryLightBrush}" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Margin="0,8,0,16"/>
                    <TextBlock x:Name="NetWorthChangeText" 
                               Text="+£0.00 this month" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Recent Transactions -->
            <Border Background="{StaticResource CardBrush}" 
                    CornerRadius="12" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Recent Transactions" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>
                    
                    <ListView x:Name="RecentTransactionsList" 
                              ItemsSource="{x:Bind RecentTransactions}"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{Binding Icon}" 
                                               FontSize="20" 
                                               VerticalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding Description}" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Date}" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Amount}" 
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
